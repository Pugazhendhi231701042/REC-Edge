// Prisma Schema for Regulation 26 - Curriculum & Syllabus Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  userCode     String?  @unique // Human-readable unique ID e.g. CS101, CD101, ADM01, DEAN01
  email        String   @unique
  password     String
  name         String
  role         String   // SUPERADMIN, MASTERADMIN, HOD, FACULTY
  departmentId String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department          Department?          @relation("UserDepartment", fields: [departmentId], references: [id])
  headedDepartment    Department?          @relation("DepartmentHoD")
  assignedSubjects    Subject[]            @relation("FacultyAssignedSubjects")
  createdSubjects     Subject[]            @relation("SubjectCreator")
  initiatedStages     AcademicStage[]      @relation("StageInitiator")
  requestedExtensions ExtensionRequest[]   @relation("ExtensionRequester")
  decidedExtensions   ExtensionRequest[]   @relation("ExtensionDecider")
  syllabusSubmissions SyllabusSubmission[] @relation("FacultySubmissions")
  approvedSubmissions SyllabusSubmission[] @relation("ApprovedBySubmissions")
  submittedBundles    DepartmentCurriculumBundle[] @relation("BundleSubmittedBy")
  approvedBundles     DepartmentCurriculumBundle[] @relation("BundleApprovedBy")
  submittedProgPlans  ProgrammeCurriculumSubmission[] @relation("ProgPlanSubmittedBy")
  approvedProgPlans   ProgrammeCurriculumSubmission[] @relation("ProgPlanApprovedBy")
  notifications       Notification[]       @relation("UserNotifications")
  auditLogs           AuditLog[]           @relation("UserAuditLogs")
}

model Department {
  id             String   @id @default(uuid())
  programmeType  String   // B.E., B.Tech, M.E., M.Tech
  programmeName  String   // Computer Science and Engineering
  shortName      String   // CSE
  departmentCode String   @unique // CS
  semesters      Int      @default(8)
  hodId          String?  @unique
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hod               User?              @relation("DepartmentHoD", fields: [hodId], references: [id])
  users             User[]             @relation("UserDepartment")
  subjects          Subject[]
  poConfigurations  POConfiguration[]
  psoConfigurations PSOConfiguration[]
  extensionRequests ExtensionRequest[]
  programOutcomeStatements ProgramOutcomeStatement[]
  programSpecificOutcomeStatements ProgramSpecificOutcomeStatement[]
  programEducationalObjectiveStatements ProgramEducationalObjectiveStatement[]
  curriculumBundles DepartmentCurriculumBundle[]
  programmeSubjectPlans ProgrammeSubjectPlan[]
  programmeCurriculumSubmissions ProgrammeCurriculumSubmission[]
}

model Regulation {
  id          String   @id @default(uuid())
  code        String   @unique // "26", "23", "29"
  name        String   // "Regulation 26"
  displayName String   // "Regulation 26 (2026)"
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjects          Subject[]
  poConfigurations  POConfiguration[]
  psoConfigurations PSOConfiguration[]
  programOutcomeStatements ProgramOutcomeStatement[]
  programSpecificOutcomeStatements ProgramSpecificOutcomeStatement[]
  programEducationalObjectiveStatements ProgramEducationalObjectiveStatement[]
  curriculumBundles DepartmentCurriculumBundle[]
  programmeSubjectPlans ProgrammeSubjectPlan[]
  programmeCurriculumSubmissions ProgrammeCurriculumSubmission[]
}

model AcademicYear {
  id        String   @id @default(uuid())
  year      String   @unique // "2026–2027"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects Subject[]
  curriculumBundles DepartmentCurriculumBundle[]
  programmeSubjectPlans ProgrammeSubjectPlan[]
  programmeCurriculumSubmissions ProgrammeCurriculumSubmission[]
}

model AcademicStage {
  id            String    @id @default(uuid())
  order         Int       @default(1)
  name          String    // Stage name
  description   String?
  startDate     DateTime?
  deadline      DateTime?
  venue         String?
  status        String    @default("INACTIVE") // INACTIVE, ACTIVE, COMPLETED, OVERDUE
  initiatedById String?
  initiatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  initiatedBy       User?              @relation("StageInitiator", fields: [initiatedById], references: [id])
  extensionRequests ExtensionRequest[]
}

model ExtensionRequest {
  id                String    @id @default(uuid())
  stageId           String
  departmentId      String
  requestedById     String
  currentDeadline   DateTime
  requestedDeadline DateTime
  reason            String
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED
  decidedById       String?
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  stage       AcademicStage @relation(fields: [stageId], references: [id])
  department  Department    @relation(fields: [departmentId], references: [id])
  requestedBy User          @relation("ExtensionRequester", fields: [requestedById], references: [id])
  decidedBy   User?         @relation("ExtensionDecider", fields: [decidedById], references: [id])
}

model SubjectType {
  id           String  @id @default(uuid())
  name         String  // Theory, Lab, Lab-Oriented Theory, Project, Project-Oriented Theory
  code         Int     // Configurable integer code (e.g. 1, 2, 3, 4, 5)
  templateType String  // THEORY, LAB, LAB_ORIENTED_THEORY
  active       Boolean @default(true)

  subjects Subject[]
}

model SubjectCategory {
  id          String  @id @default(uuid())
  code        String  @unique // PC, PE, MC, OE, EEC
  name        String
  description String?
  active      Boolean @default(true)

  subjects Subject[]
}

model CreditConfig {
  id                String   @id @default("default-credit-config")
  calculationMethod String   @default("SUM") // SUM (C = L+T+P) or WEIGHTED (C = L*wL + T*wT + P*wP)
  lWeight           Float    @default(1.0)
  tWeight           Float    @default(1.0)
  pWeight           Float    @default(0.5)
  hoursPerCredit    Int      @default(15) // 15 contact hours per credit standard
  customPrefixes    String?  @default("GE, PH, HS, MC, CS, EC, EE, ME, CE, AI, CB, IT")

  // Step 2 Governance Constraints (MasterAdmin Configurable)
  minTotalCredits      Float    @default(160.0) // Min overall programme credits
  maxTotalCredits      Float    @default(165.0) // Max overall programme credits
  minSemCredits        Float    @default(20.0)  // Min credits per semester
  maxSemCredits        Float    @default(24.0)  // Max credits per semester
  maxLabPerSem         Int      @default(2)     // Max laboratory courses allowed per semester
  maxLabTotal          Int      @default(8)     // Max laboratory courses allowed across programme
  maxLabOrientedPerSem Int      @default(2)     // Max Lab-oriented theory courses allowed per semester
  categoryComposition  String?  @default("{\"PC\":45,\"PE\":15,\"OE\":6,\"HS\":7,\"BS\":15,\"ES\":9,\"EEC\":3}")

  updatedAt            DateTime @updatedAt
}

model SDGGoal {
  id        String   @id @default(uuid())
  sdgNumber Int      @unique // 1 to 17
  name      String   // e.g. "Quality Education"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model POConfiguration {
  id           String    @id @default(uuid())
  departmentId String
  regulationId String
  poCount      Int       @default(12)
  isLocked     Boolean   @default(false)
  lockedAt     DateTime?

  department Department @relation(fields: [departmentId], references: [id])
  regulation Regulation @relation(fields: [regulationId], references: [id])

  @@unique([departmentId, regulationId])
}

model PSOConfiguration {
  id           String    @id @default(uuid())
  departmentId String
  regulationId String
  psoCount     Int       @default(3)
  isLocked     Boolean   @default(false)
  lockedAt     DateTime?

  department Department @relation(fields: [departmentId], references: [id])
  regulation Regulation @relation(fields: [regulationId], references: [id])

  @@unique([departmentId, regulationId])
}

model Subject {
  id                String    @id @default(uuid())
  departmentId      String
  regulationId      String
  academicYearId    String
  semester          Int
  vertical          String?   // Vertical A, Vertical B, ..., Vertical H (for electives)
  subjectTypeId     String
  subjectCategoryId String
  subjectName       String
  subjectCode       String // Generated CS26421 / GE26121
  lecture           Int // L
  tutorial          Int // T
  practical         Int // P
  credits           Float // C (calculated)
  status            String    @default("DRAFT") // DRAFT, FINALIZED, ASSIGNED
  assignedFacultyId String?
  facultyDeadline   DateTime?
  syllabusStatus    String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, SUBMITTED, RETURNED_FOR_CORRECTION, RESUBMITTED, APPROVED
  finalizedAt       DateTime?
  assignedAt        DateTime?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  department      Department          @relation(fields: [departmentId], references: [id])
  regulation      Regulation          @relation(fields: [regulationId], references: [id])
  academicYear    AcademicYear        @relation(fields: [academicYearId], references: [id])
  subjectType     SubjectType         @relation(fields: [subjectTypeId], references: [id])
  subjectCategory SubjectCategory     @relation(fields: [subjectCategoryId], references: [id])
  assignedFaculty User?               @relation("FacultyAssignedSubjects", fields: [assignedFacultyId], references: [id])
  createdBy       User                @relation("SubjectCreator", fields: [createdById], references: [id])
  submission      SyllabusSubmission?
  programmeSubjectPlans ProgrammeSubjectPlan[]

  @@unique([departmentId, regulationId, semester, subjectTypeId, subjectCode])
}

model SyllabusSubmission {
  id                   String    @id @default(uuid())
  subjectId            String    @unique
  facultyId            String
  version              Int       @default(1)
  unitContactHours     Int? // Common unit contact hours for theory units
  theoryContactHours   Int? // 5 * unitContactHours
  labContactHours      Int? // Lab contact hours
  totalContactHours    Int? // Calculated total
  correctionReason     String?
  returnedAt           DateTime?
  approvedAt           DateTime?
  approvedById         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  subject            Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  faculty            User                  @relation("FacultySubmissions", fields: [facultyId], references: [id])
  approvedBy         User?                 @relation("ApprovedBySubmissions", fields: [approvedById], references: [id])
  objectives         Objective[]
  syllabusUnits      SyllabusUnit[]
  experiments        Experiment[]
  courseOutcomes     CourseOutcome[]
  textbooks          Textbook[]
  references         Reference[]
  coPoMappings       COPOMapping[]
  coPoJustifications COPOJustification[]
  sdgMappings        SyllabusSDGMapping[]
}

model Objective {
  id          String @id @default(uuid())
  syllabusId  String
  order       Int
  description String

  syllabus SyllabusSubmission @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
}

model SyllabusUnit {
  id         String @id @default(uuid())
  syllabusId String
  unitNumber Int // 1 to 5
  unitName   String
  content    String

  syllabus SyllabusSubmission @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
}

model Experiment {
  id               String @id @default(uuid())
  syllabusId       String
  experimentNumber Int
  title            String

  syllabus SyllabusSubmission @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
}

model CourseOutcome {
  id             String  @id @default(uuid())
  syllabusId     String
  coNumber       Int     // 1 to 5 mandatory
  cognitiveLevel String? // e.g. "K1", "K2", "K3", "K4", "K5", "K6"
  description    String

  syllabus SyllabusSubmission @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
}

model ProgramOutcomeStatement {
  id           String   @id @default(uuid())
  departmentId String
  regulationId String
  poKey        String   // PO1 to PO12
  statement    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  regulation Regulation @relation(fields: [regulationId], references: [id])

  @@unique([departmentId, regulationId, poKey])
}

model ProgramSpecificOutcomeStatement {
  id           String   @id @default(uuid())
  departmentId String
  regulationId String
  psoKey       String   // PSO1 to PSO3
  statement    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  regulation Regulation @relation(fields: [regulationId], references: [id])

  @@unique([departmentId, regulationId, psoKey])
}

model ProgramEducationalObjectiveStatement {
  id           String   @id @default(uuid())
  departmentId String
  regulationId String
  peoKey       String   // PEO1, PEO2, PEO3, PEO4...
  statement    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  regulation Regulation @relation(fields: [regulationId], references: [id])

  @@unique([departmentId, regulationId, peoKey])
}

model DepartmentCurriculumBundle {
  id               String    @id @default(uuid())
  departmentId     String
  regulationId     String
  academicYearId   String
  status           String    @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, RETURNED_FOR_CORRECTION
  submittedAt      DateTime?
  submittedById    String?
  approvedAt       DateTime?
  approvedById     String?
  correctionReason String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  department   Department   @relation(fields: [departmentId], references: [id])
  regulation   Regulation   @relation(fields: [regulationId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  submittedBy  User?        @relation("BundleSubmittedBy", fields: [submittedById], references: [id])
  approvedBy   User?        @relation("BundleApprovedBy", fields: [approvedById], references: [id])

  @@unique([departmentId, regulationId, academicYearId])
}

model Textbook {
  id         String  @id @default(uuid())
  syllabusId String
  order      Int
  title      String
  authors    String
  edition    String?
  publisher  String?
  year       String?

  syllabus SyllabusSubmission @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
}

model Reference {
  id          String  @id @default(uuid())
  syllabusId  String
  order       Int
  title       String
  authors     String?
  edition     String?
  publisher   String?
  year        String?
  url         String?
  description String?

  syllabus SyllabusSubmission @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
}

model COPOMapping {
  id          String @id @default(uuid())
  syllabusId  String
  coNumber    Int // 1 to 5
  poKey       String // PO1..PO12, PSO1..PSO3
  correlation Int // 0=No correlation ('-'), 1=Low, 2=Medium, 3=High

  syllabus SyllabusSubmission @relation(fields: [syllabusId], references: [id], onDelete: Cascade)

  @@unique([syllabusId, coNumber, poKey])
}

model COPOJustification {
  id            String @id @default(uuid())
  syllabusId    String
  coNumber      Int
  poKey         String
  justification String

  syllabus SyllabusSubmission @relation(fields: [syllabusId], references: [id], onDelete: Cascade)

  @@unique([syllabusId, coNumber, poKey])
}

model SyllabusSDGMapping {
  id         String @id @default(uuid())
  syllabusId String
  coNumber   Int    // 1 to 5
  sdgNumber  Int    // 1 to 17
  topic      String // Specific topic from corresponding unit

  syllabus SyllabusSubmission @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
}

model Notification {
  id            String   @id @default(uuid())
  recipientId   String
  title         String
  message       String
  type          String
  relatedEntity String?
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  recipient User @relation("UserNotifications", fields: [recipientId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  userRole  String
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  user User @relation("UserAuditLogs", fields: [userId], references: [id])
}

model ProgrammeSubjectPlan {
  id             String       @id @default(uuid())
  departmentId   String       // The programme department (e.g. CSE)
  regulationId   String
  academicYearId String
  semester       Int          // Semester 1 to N
  subjectId      String       // The Dean-approved subject added to this semester
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  regulation     Regulation   @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([departmentId, regulationId, academicYearId, semester, subjectId])
}

model ProgrammeCurriculumSubmission {
  id               String       @id @default(uuid())
  departmentId     String
  regulationId     String
  academicYearId   String
  status           String       @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, RETURNED_FOR_CORRECTION
  totalCredits     Float        @default(0)
  submittedAt      DateTime?
  submittedById    String?
  approvedAt       DateTime?
  approvedById     String?
  correctionReason String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  department       Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  regulation       Regulation   @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  submittedBy      User?        @relation("ProgPlanSubmittedBy", fields: [submittedById], references: [id])
  approvedBy       User?        @relation("ProgPlanApprovedBy", fields: [approvedById], references: [id])

  @@unique([departmentId, regulationId, academicYearId])
}

